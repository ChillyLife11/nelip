# Скопировать в .env и поправить под своё окружение.

# Хост бэкенда: на него проксируется /api в dev и с него грузятся картинки
VITE_API_HOST=https://medix.amgs.online

# Клиника, за которую работает мини-апп: от неё зависит и company_id в запросах,
# и подпапка сборки — <VITE_ASSET_HOST>/max/app-<company_id>/
VITE_COMPANY_ID=4

# Хост, с которого раздаются файлы сборки. По умолчанию — VITE_API_HOST.
# VITE_ASSET_HOST=https://medix.amgs.online

# Тестовые справочники и записи вместо бэкенда (@/api/mock). Сейчас включены по
# умолчанию: у клиники на сервере нет ни услуг, ни расписания, и шаги записи
# иначе не пройти. Когда бэкенд наполнят — выключить.
# VITE_MOCK_DATA=false
